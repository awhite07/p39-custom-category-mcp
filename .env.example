# Peer39 MCP server credentials — example template. Copy to `.env` and fill in.
#
# Only USERNAME and PASSWORD are required here. Everything else can be set via the
# `peer39_configure` MCP tool at runtime (persisted to ~/.peer39-mcp/config.json) or
# passed per-call as tool arguments. The MCP will ask you for missing values when
# it needs them.

# REQUIRED — your Peer39 login. The username must have "External API" + "RTB Buyer" roles
# (set by your Peer39 integration manager).
PEER39_USERNAME=
PEER39_PASSWORD=

# ---- everything below is optional ----
# Set any of these here if you want them baked in. Otherwise leave blank and the MCP
# will ask via conversation the first time it needs them.

# Your account id in Peer39 (numeric). Find at https://app.peer39.com/accounts
# PEER39_BUYER_ID=

# Auto-generated "system name" for your account. Find at https://app.peer39.com/accounts.
# Only needed for create-category calls.
# PEER39_SYSTEM=

# Default email used as the "owner" on new/updated categories.
# PEER39_USER_EMAIL=

# Default DSP partner id used when a tool call doesn't specify one. Common values:
#   841  = Microsoft Advertising (Xandr)
#   730  = MediaMath
#   1407 = The Trade Desk
#   1419 = Basis Technologies
#   1423 = Yahoo (formerly Verizon Media)
# Full list in src/partners.ts.
# PEER39_DEFAULT_PARTNER_ID=

# Base URL override (default https://app.peer39.com)
# PEER39_BASE_URL=https://app.peer39.com
